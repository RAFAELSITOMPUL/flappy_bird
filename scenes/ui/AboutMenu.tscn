[node name="AudioLabel" type="Label" parent="Root/Outer/Scroll/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.9, 0.9, 0.9, 1)
theme_override_font_sizes/font_size = 14
text = "Game dilengkapi dengan Background Music dan Sound Effects.

Background Music memberikan suasana selama bermain di menu maupun dalam game.

Sound Effects memberikan feedback audio saat pemain melakukan flap, mendapatkan score, menekan tombol, dan saat Game Over.

Volume musik dan SFX dapat diatur secara terpisah melalui menu Settings."
autowrap_mode = 2

[node name="H1Graphics" type="Label" parent="Root/Outer/Scroll/Content"]
