[node name="WelcomeLabel" type="Label" parent="Root/Outer/Scroll/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.95, 0.95, 0.95, 1)
theme_override_font_sizes/font_size = 15
text = "Selamat datang di Flappy Bird!

Flappy Bird adalah game 2D arcade sederhana dengan gameplay yang mudah dipahami tetapi membutuhkan ketepatan dan konsentrasi tinggi.

Kendalikan burung dengan melakukan tap pada layar atau menekan tombol yang tersedia untuk membuat burung terbang dan melewati celah di antara pipa.

Semakin banyak pipa yang berhasil dilewati, semakin tinggi score yang akan kamu dapatkan. Cobalah mendapatkan score setinggi mungkin dan kalahkan High Score milikmu sendiri!"
autowrap_mode = 2

