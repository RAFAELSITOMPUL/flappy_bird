[node name="HowToPlayLabel" type="Label" parent="Root/Outer/Scroll/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.9, 0.9, 0.9, 1)
theme_override_font_sizes/font_size = 14
text = "WINDOWS
  SPACE / Klik Kiri Mouse  ->  Flap (burung naik)
  Hindari pipa atas dan bawah
  Jangan menyentuh tanah
  Lewati pipa untuk mendapatkan score
  ESC  ->  Pause game

ANDROID
  Tap layar  ->  Flap (burung naik)
  Atur waktu tap agar burung melewati celah pipa
  Hindari pipa bagian atas dan bawah
  Jangan menyentuh tanah"
autowrap_mode = 2

