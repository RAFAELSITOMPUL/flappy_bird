theme_override_font_sizes/font_size = 14
text = "- Gameplay arcade 2D
- Sistem score real-time
- High Score tersimpan
- Game Over dan Restart
- Pause Game
- Main Menu
- Settings: Audio dan Graphics
- Fullscreen / Borderless Fullscreen / Windowed
- Resolution Settings (Windows)
- FPS Target (30 / 60 / 120 / Unlimited)
- Graphics Quality (LOW / MEDIUM / HIGH)
- Background Music dan Sound Effects
- Kontrol Touch (Android)
- Kontrol Keyboard dan Mouse (Windows)
- Save dan Load Settings otomatis
- UI responsif untuk berbagai resolusi
- Dukungan Windows dan Android"
autowrap_mode = 2

[node name="H1Audio" type="Label" parent="Root/Outer/Scroll/Content"]
